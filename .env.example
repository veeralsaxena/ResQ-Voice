# ResQ-Voice — copy to .env (repo root) and frontend/.env.local
# Placeholders only in git. Never commit real keys.

# --- LiveKit WebRTC (recommended for demo: local --dev) ---
# Local: docker compose up -d   OR   brew install livekit && livekit-server --dev
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
NEXT_PUBLIC_LIVEKIT_URL=ws://127.0.0.1:7880
# Cloud alternative: wss://YOUR_PROJECT.livekit.cloud + keys from cloud.livekit.io

# --- Rime TTS (required — only spoken output) ---
RIME_API_KEY=your_rime_api_key
RIME_MODEL=mistv3
RIME_SPEAKER=astra
RIME_LANG=en
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_WS_ENDPOINT=wss://users-ws.rime.ai

# --- Speech in ---
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# --- LLM (Groq recommended) ---
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

DOSAGE_LOOKUP_LATENCY_S=2.5
